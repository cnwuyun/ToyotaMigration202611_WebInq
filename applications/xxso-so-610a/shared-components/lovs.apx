    }
)

lov xxso-warehouse-610a (
    name: XXSO_WAREHOUSE_610A
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select m.secondary_inventory_name as code,
                   nvl(m.description, m.secondary_inventory_name) as name
              from mtl_secondary_inventories m
             where m.disable_date is null
             union
            select l.lookup_code,
                   l.meaning
              from fnd_lookup_values l
             where l.lookup_type = 'XXSO_MATERIALS_PARTNO'
               and l.enabled_flag = 'Y'
             order by 1
            ```
    }
    columnMapping {
        display: NAME
        return: CODE
    }
)
