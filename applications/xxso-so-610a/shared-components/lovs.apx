lov xxso-furnished-place-610a (
    name: XXSO_FURNISHED_PLACE_610A
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select supply_dest_code,
                   supply_dest_name
              from xxso_supply_dest_all_v
             where enabled_flag = 'Y'
               and (   xxso_so_610a_auth_pkg.is_tmc_user = 'Y'
                    or supply_dest_code = xxso_so_610a_auth_pkg.my_supply_dest_code )
             order by supply_dest_code
            ```
    }
    columnMapping {
        display: SUPPLY_DEST_NAME
