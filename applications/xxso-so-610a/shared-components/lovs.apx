lov xxso-buying-and-selling-cls (
    name: XXSO_BUYING_AND_SELLING_CLS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select lookup_code,
                   meaning
              from fnd_lookup_values
             where lookup_type = 'XXSO_BUYING_AND_SELLING_CLS'
               and enabled_flag = 'Y'
             order by display_sequence, lookup_code
            ```
    }
    columnMapping {
        display: MEANING
        return: LOOKUP_CODE
    }
)

