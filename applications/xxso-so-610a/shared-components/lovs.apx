lov xxso-supplier-610a (
    name: XXSO_SUPPLIER_610A
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select supplier_code,
                   supplier_name
              from xxso_supplier_all_v
             where enabled_flag = 'Y'
               and (   xxso_so_610a_auth_pkg.is_tmc_user = 'Y'
                    or supplier_code = xxso_so_610a_auth_pkg.my_supplier_code )
             order by supplier_code
            ```
    }
    columnMapping {
        display: SUPPLIER_NAME
        return: SUPPLIER_CODE
    }
)

lov xxso-brought-in-610a (
    name: XXSO_BROUGHT_IN_610A
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select brought_in_code,
                   brought_in_name
              from xxso_brought_in_lookup
             where enabled_flag = 'Y'
             order by brought_in_code
            ```
    }
    columnMapping {
        display: BROUGHT_IN_NAME
        return: BROUGHT_IN_CODE
    }
)

lov xxso-procurement-group-610a (
    name: XXSO_PROCUREMENT_GROUP_610A
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct
                   procurement_group_code as code,
                   procurement_group_code as name
              from xxso_payment_deliverys_sum
             where procurement_group_code is not null
             order by procurement_group_code
            ```
    }
    columnMapping {
        display: NAME
        return: CODE
    }
)

