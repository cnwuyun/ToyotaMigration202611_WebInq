page 1 (
    name: 支払納品情報検索
    alias: PAYMENT-DELIVERY-SEARCH
    title: 支払納品情報検索
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        authorizationScheme: @is-payment-delivery-user
        formAutoComplete: false
    }

    region payment-delivery-search-header (
        name: 支払納品情報検索
        title: 支払納品情報検索
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region search-conditions (
        name: 検索条件
        title: 検索条件
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region payment-delivery-report (
        name: 支払納品情報一覧
        title: 支払納品情報一覧
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.y_item_no,
                       v.item_name,
                       v.supplier_code,
                       v.supplier_name,
                       v.buying_and_selling_class,
                       v.buying_and_selling_class_mean,
                       v.brought_in_code,
                       v.brought_in_name,
                       v.brought_in_factory_class,
                       v.maker_code,
                       v.maker_name,
                       v.delivery_quantity_disp,
                       v.delivery_date,
                       v.delivery_number,
                       v.processing_date,
                       v.status,
                       v.status_meaning,
                       v.period_class,
                       v.procurement_group_code,
                       v.procurement_personnel_code,
                       v.subcontract_act_cls,
                       v.exclusive_flg_mean,
                       v.spec,
                       v.tool_no,
                       v.purchase_furnished_price_disp,
                       v.purchase_payment_money_disp,
                       v.control_number,
                       v.arrangement_serial_no,
                       v.recorded_ym,
                       v.early_and_late_class,
                       v.early_and_late_class_mean,
                       v.multiple_suppliers_class,
                       v.multiple_suppliers_class_mean,
                       v.update_fnd_user,
                       v.update_date,
                       v.revate_unit_price_disp,
                       v.payment_furnished_unit_price_disp,
                       v.revate_amount_of_money_disp,
                       v.payment_furnished_amount_disp,
                       v.currency_code,
                       v.furnishing_group,
                       v.furnished_place_code,
                       v.furnished_name,
                       v.furnished_industrial_type,
                       v.wh_code,
                       v.warehouse_name,
                       v.warehouse_industrial_class,
                       v.unit_price_class,
                       v.unit_price_class_mean,
                       v.rep_pattern,
                       v.rep_pattern_mean,
                       v.repairable_flag,
                       v.repairable_flag_mean,
                       v.last_purchase_furnish_price_disp,
                       v.last_revate_unit_price_disp,
                       v.last_payment_furnished_price_disp,
                       v.data_type_mean,
                       v.back_correction_flag_mean,
                       v.total_cls_mean,
                       v.order_date
                  from xxso_so_webinq_610a_v v
                 where (:P1_DELIVERY_DATE_FROM is null
                        or v.delivery_date >= to_date(:P1_DELIVERY_DATE_FROM, 'YYYY/MM/DD'))
                   and (:P1_DELIVERY_DATE_TO is null
                        or v.delivery_date <= to_date(:P1_DELIVERY_DATE_TO, 'YYYY/MM/DD'))
                   and (:P1_STATUS is null or lower(v.status) = lower(:P1_STATUS))
                   and (:P1_Y_ITEM_NO is null
                        or lower(v.y_item_no) like '%' || lower(:P1_Y_ITEM_NO) || '%')
                   and (:P1_SUPPLIER_CODE is null or lower(v.supplier_code) = lower(:P1_SUPPLIER_CODE))
                   and (:P1_BUYING_AND_SELLING_CLASS is null
                        or lower(v.buying_and_selling_class) = lower(:P1_BUYING_AND_SELLING_CLASS))
                   and (:P1_DELIVERY_NUMBER is null
                        or lower(v.delivery_number) like '%' || lower(:P1_DELIVERY_NUMBER) || '%')
                   and (:P1_PROCUREMENT_GROUP_CODE is null
                        or lower(v.procurement_group_code) = lower(:P1_PROCUREMENT_GROUP_CODE))
                   and (:P1_PROCUREMENT_PERSONNEL_CODE is null
                        or lower(v.procurement_personnel_code) = lower(:P1_PROCUREMENT_PERSONNEL_CODE))
                   and (:P1_MULTIPLE_SUPPLIERS_CLASS is null
                        or lower(v.multiple_suppliers_class) = lower(:P1_MULTIPLE_SUPPLIERS_CLASS))
                   and (:P1_ARRANGEMENT_SERIAL_NO is null
                        or lower(v.arrangement_serial_no) = lower(:P1_ARRANGEMENT_SERIAL_NO))
                   and (:P1_FURNISHING_GROUP is null
                        or lower(v.furnishing_group) = lower(:P1_FURNISHING_GROUP))
                   and (:P1_FURNISHED_PLACE_CODE is null
                        or lower(v.furnished_place_code) = lower(:P1_FURNISHED_PLACE_CODE))
                   and (:P1_WH_CODE is null or lower(v.wh_code) = lower(:P1_WH_CODE))
                   and (:P1_BROUGHT_IN_CODE is null
                        or lower(v.brought_in_code) = lower(:P1_BROUGHT_IN_CODE))
                   and xxso_so_610a_auth_pkg.scope_ok(v.supplier_code, v.furnished_place_code) = 'Y'
                 order by v.delivery_date desc, v.delivery_number, v.arrangement_serial_no
                ```
            pageItemsToSubmit: P1_DELIVERY_DATE_FROM,P1_DELIVERY_DATE_TO,P1_STATUS,P1_Y_ITEM_NO,P1_SUPPLIER_CODE,P1_BUYING_AND_SELLING_CLASS,P1_DELIVERY_NUMBER,P1_PROCUREMENT_GROUP_CODE,P1_PROCUREMENT_PERSONNEL_CODE,P1_MULTIPLE_SUPPLIERS_CLASS,P1_ARRANGEMENT_SERIAL_NO,P1_FURNISHING_GROUP,P1_FURNISHED_PLACE_CODE,P1_WH_CODE,P1_BROUGHT_IN_CODE
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: 該当する支払納品情報はありません。
        }
        pagination {
            type: rowRangesXToYOfZ
        }

        column Y_ITEM_NO (
            type: plainText
            heading {
