    button search (
        buttonName: SEARCH
        label: 検索
        layout {
            sequence: 160
            region: @search-conditions
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            action: submitPage
            executeValidations: true
        }
    )

    button clear (
        buttonName: CLEAR
        label: クリア
        layout {
            sequence: 170
            region: @search-conditions
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: resetPage
        }
    )

    pageItem P1_Y_ITEM_NO (
        type: textField
        label {
            label: Y品番
        }
        layout {
            sequence: 10
            region: @search-conditions
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
        }
        help {
            inlineHelpText: Y品番の一部一致で検索します。空欄の場合は条件に含めません。
        }
    )

    pageItem P1_SUPPLIER_CODE (
        type: popupLov
        label {
            label: 仕入先コード
        }
        lov {
            type: sharedComponent
            lov: @xxso-supplier-610a
        }
        layout {
            sequence: 20
            region: @search-conditions
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: xxso_so_610a_auth_pkg.my_supplier_code
        }
        readOnly {
            type: expression
            plsqlExpression: xxso_so_610a_auth_pkg.is_supplier_user = 'Y'
        }
    )

    pageItem P1_BUYING_AND_SELLING_CLASS (
        type: selectList
        label {
            label: 売買区分
        }
        lov {
            type: sharedComponent
            lov: @xxso-buying-and-selling-cls
        }
        layout {
            sequence: 30
            region: @search-conditions
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: 売買区分（K＝購買 / U＝支給）で絞り込みます。支給（U）を選ぶと支給先・持込先の入力可否が切り替わります。
        }
    )

    pageItem P1_DELIVERY_DATE_FROM (
        type: datePicker
        label {
            label: 納入年月日（カラ）
        }
        layout {
            sequence: 40
            region: @search-conditions
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: YYYY/MM/DD
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: 納入年月日の検索開始日を指定します。必須項目です。
        }
    )

    pageItem P1_DELIVERY_DATE_TO (
        type: datePicker
        label {
            label: 納入年月日（マデ）
        }
        layout {
            sequence: 50
            region: @search-conditions
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: YYYY/MM/DD
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: 納入年月日の検索終了日を指定します。開始日以降の日付を指定してください。必須項目です。
        }
    )

    pageItem P1_STATUS (
