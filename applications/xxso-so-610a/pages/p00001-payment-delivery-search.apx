    dynamicAction toggle-supply-dest-fields (
        name: 売買区分による入力可否制御
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P1_BUYING_AND_SELLING_CLASS
        }
        action disable-supply-dest (
            name: 支給先・支給係を無効化
            action: disable
            execution {
                sequence: 10
            }
            affectedElements {
                selectionType: items
                items: P1_FURNISHING_GROUP,P1_FURNISHED_PLACE_CODE
            }
            clientSideCondition {
                type: item=value
                item: P1_BUYING_AND_SELLING_CLASS
                value: U
            }
        )
        action enable-supply-dest (
            name: 支給先・支給係を有効化
            action: enable
            execution {
                sequence: 20
            }
            affectedElements {
                selectionType: items
                items: P1_FURNISHING_GROUP,P1_FURNISHED_PLACE_CODE
            }
            clientSideCondition {
                type: item!=value
                item: P1_BUYING_AND_SELLING_CLASS
                value: U
            }
        )
        action disable-brought-in (
            name: 持込先を無効化
            action: disable
            execution {
                sequence: 30
            }
            affectedElements {
                selectionType: items
                items: P1_BROUGHT_IN_CODE
            }
            clientSideCondition {
                type: item=value
                item: P1_BUYING_AND_SELLING_CLASS
                value: U
            }
        )
        action enable-brought-in (
            name: 持込先を有効化
            action: enable
            execution {
                sequence: 40
            }
            affectedElements {
                selectionType: items
                items: P1_BROUGHT_IN_CODE
            }
            clientSideCondition {
                type: item!=value
                item: P1_BUYING_AND_SELLING_CLASS
                value: U
            }
        )
    )

    validation VAL_DELIVERY_DATE_RANGE (
        name: 納入年月日範囲チェック
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                return to_date( :P1_DELIVERY_DATE_FROM, 'YYYY/MM/DD' )
                       <= to_date( :P1_DELIVERY_DATE_TO, 'YYYY/MM/DD' );
                ```
        }
        error {
            errorMessage: 納入年月日（カラ）は納入年月日（マデ）以前の日付を指定してください。
            associatedItem: @P1_DELIVERY_DATE_TO
        }
    )

)
