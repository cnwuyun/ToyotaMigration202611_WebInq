# ============================================================
#  APEX App 103 install runner - configuration (run_install_f103.bat)
#  NOTE: .env contains connection info. Never commit this file.
# ============================================================

# --- Target schema (APEX workspace parsing schema, NOT ADMIN) ---
# Workspace MAPS -> schema WKSP_MAPS (app 103 MAPS_WUYUN lives here)
DB_SCHEMA=WKSP_MAPS

# --- TNS alias from wallet/tnsnames.ora ---
# Options: toyota_high (admin/DDL) / toyota_medium / toyota_low (app-level)
TNS_ALIAS=toyota_medium

# --- SQLcl executable path ---
SQLCL_PATH=C:\Users\robin wu\.codebuddycn\extensions\oracle.sql-developer-26.3.1\dbtools\sqlcl\bin\sql.exe

# --- Database password ---
# Left empty on purpose: the batch file will prompt interactively if blank.
# Fill in only if you accept the credential residing in this local file.
DB_PASSWORD=ASDqwe123##1
